# Halo – environment variables (copy to .env and fill in)
# ALL defaults point to fully local mode; no network calls with personal data.

APP_NAME=Halo
ENVIRONMENT=development

# LLM (local Ollama)
LLM_PROVIDER=LOCAL
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2:latest

# Embeddings (local)
EMBEDDING_PROVIDER=LOCAL
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database
DATABASE_PATH=./data/halo.db

# Optional cloud fallback keys (never used with personal data)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
